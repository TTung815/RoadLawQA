# V2 provider selection. Gemini variables remain compatible when LLM_MODEL_NAME is absent.
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-6-luna
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=16384
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_TRANSIENT_RETRIES=2

# To use Gemini, set LLM_PROVIDER=gemini and LLM_MODEL_NAME to its model ID.
# Single key or comma-separated keys for automatic rotation on 429 quota limits:
GEMINI_API_KEY=your_primary_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL_NAME=gemini-2.5-flash

# Bounded retrieval of related clauses and explicit references.
STRUCTURAL_EXPANSION_ENABLED=true
# Load the index and local models in the background when the API starts.
WARMUP_ON_STARTUP=true

# Streamlit calls the V2 API; both serving and evaluation use the current-law index.
ROADLAWQA_API_URL=http://127.0.0.1:8000
RETRIEVAL_BACKEND=structured
HYBRID_ALPHA=0.5
# Local model inference: auto selects CUDA/MPS when available, otherwise CPU.
# Use mps explicitly on Apple Silicon to fail clearly if GPU access is unavailable.
# CPU is faster for the small query-embedding batches measured on this Mac.
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=auto

# Structured retrieval only: bounded candidate pool and batches sorted by token length.
HYBRID_CANDIDATE_LIMIT=20
COMPOUND_CANDIDATE_LIMIT=32
RERANKER_BATCH_SIZE=4
