{
  "$defs": {
    "AnswerFacet": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_group_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Group Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rule",
            "definition",
            "money",
            "license_points",
            "additional_sanction",
            "condition",
            "exception",
            "reasoning",
            "temporal",
            "uncertainty"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "support_state": {
          "default": "unknown",
          "enum": [
            "positive_support",
            "negative_support",
            "unknown"
          ],
          "title": "Support State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "description"
      ],
      "title": "AnswerFacet",
      "type": "object"
    },
    "CandidateRevision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "keep",
            "edit",
            "drop"
          ],
          "title": "Action",
          "type": "string"
        },
        "drafted_by": {
          "minLength": 1,
          "title": "Drafted By",
          "type": "string"
        },
        "drafted_on": {
          "format": "date",
          "title": "Drafted On",
          "type": "string"
        },
        "original_query": {
          "minLength": 1,
          "title": "Original Query",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "type_revision_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Revision Reason"
        }
      },
      "required": [
        "action",
        "original_query",
        "rationale",
        "drafted_by",
        "drafted_on"
      ],
      "title": "CandidateRevision",
      "type": "object"
    },
    "EvidenceGroup": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "references"
      ],
      "title": "EvidenceGroup",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "article": {
          "minLength": 1,
          "title": "Article",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clause"
        },
        "law": {
          "minLength": 1,
          "title": "Law",
          "type": "string"
        },
        "point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Point"
        },
        "processed_id": {
          "minLength": 1,
          "title": "Processed Id",
          "type": "string"
        },
        "role": {
          "default": "support",
          "enum": [
            "support",
            "context",
            "contradicts_legacy"
          ],
          "title": "Role",
          "type": "string"
        },
        "runtime_id": {
          "minLength": 1,
          "title": "Runtime Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "uuid": {
          "minLength": 1,
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "processed_id",
        "runtime_id",
        "uuid",
        "citation",
        "law",
        "article",
        "clause",
        "point",
        "text_sha256"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "GoldLabels": {
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of Date"
        },
        "evidence_groups": {
          "items": {
            "$ref": "#/$defs/EvidenceGroup"
          },
          "title": "Evidence Groups",
          "type": "array"
        },
        "expected_coverage": {
          "default": "unassigned",
          "enum": [
            "unassigned",
            "sufficient",
            "insufficient",
            "conditional"
          ],
          "title": "Expected Coverage",
          "type": "string"
        },
        "external_evidence_needed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "External Evidence Needed",
          "type": "array"
        },
        "failure_categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "publication": {
          "$ref": "#/$defs/PublicationExpectation"
        },
        "reference_answer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Answer"
        },
        "required_facets": {
          "items": {
            "$ref": "#/$defs/AnswerFacet"
          },
          "title": "Required Facets",
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "technical_audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalAudit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal_basis": {
          "default": "unresolved",
          "enum": [
            "unresolved",
            "frozen_corpus",
            "explicit_date"
          ],
          "title": "Temporal Basis",
          "type": "string"
        }
      },
      "required": [
        "publication"
      ],
      "title": "GoldLabels",
      "type": "object"
    },
    "HistoricalRun": {
      "additionalProperties": false,
      "description": "Observed legacy run data; never treated as gold or rerun measurement.",
      "properties": {
        "legal_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Accuracy"
        },
        "legal_citation": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Citation"
        },
        "model_answer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Answer"
        },
        "model_citations_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Citations Raw"
        },
        "relevance": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "retriever_sources_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retriever Sources Raw"
        },
        "total_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Score"
        }
      },
      "title": "HistoricalRun",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "PublicationExpectation": {
      "additionalProperties": false,
      "properties": {
        "allowed_statuses": {
          "items": {
            "enum": [
              "answered",
              "insufficient_evidence",
              "verification_failed"
            ],
            "type": "string"
          },
          "title": "Allowed Statuses",
          "type": "array"
        },
        "disposition": {
          "default": "unassigned",
          "enum": [
            "unassigned",
            "publish",
            "abstain",
            "conditional"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "rationale"
      ],
      "title": "PublicationExpectation",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "reviewed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed On"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "default": "needs_review",
          "enum": [
            "needs_review",
            "approved",
            "excluded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "SourceRow": {
      "additionalProperties": false,
      "properties": {
        "csv_record": {
          "minimum": 2,
          "title": "Csv Record",
          "type": "integer"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "historical_id": {
          "minLength": 1,
          "title": "Historical Id",
          "type": "string"
        },
        "raw_fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Raw Fields",
          "type": "object"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256",
        "csv_record",
        "historical_id",
        "raw_fields"
      ],
      "title": "SourceRow",
      "type": "object"
    },
    "TechnicalAudit": {
      "additionalProperties": false,
      "properties": {
        "audited_on": {
          "format": "date",
          "title": "Audited On",
          "type": "string"
        },
        "citation_status": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "external_source_needed"
          ],
          "title": "Citation Status",
          "type": "string"
        },
        "external_sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "External Sources",
          "type": "array"
        },
        "findings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "recommended_answer": {
          "minLength": 1,
          "title": "Recommended Answer",
          "type": "string"
        },
        "recommended_coverage": {
          "enum": [
            "sufficient",
            "insufficient",
            "conditional"
          ],
          "title": "Recommended Coverage",
          "type": "string"
        },
        "recommended_publication": {
          "$ref": "#/$defs/PublicationExpectation"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "needs_revision",
            "conditional",
            "external_source_needed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "citation_status",
        "audited_on",
        "scope",
        "recommended_answer",
        "recommended_coverage",
        "recommended_publication"
      ],
      "title": "TechnicalAudit",
      "type": "object"
    },
    "TemporalReview": {
      "additionalProperties": false,
      "properties": {
        "result_date": {
          "format": "date",
          "title": "Result Date",
          "type": "string"
        },
        "reviewed_on": {
          "format": "date",
          "title": "Reviewed On",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/TemporalRule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "status": {
          "const": "approved",
          "title": "Status",
          "type": "string"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "verified_through": {
          "format": "date",
          "title": "Verified Through",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "valid_from",
        "verified_through",
        "result_date",
        "rules"
      ],
      "title": "TemporalReview",
      "type": "object"
    },
    "TemporalRule": {
      "additionalProperties": false,
      "properties": {
        "base_document_id": {
          "minLength": 1,
          "title": "Base Document Id",
          "type": "string"
        },
        "base_locator": {
          "minLength": 1,
          "title": "Base Locator",
          "type": "string"
        },
        "base_pdf_page": {
          "minimum": 1,
          "title": "Base Pdf Page",
          "type": "integer"
        },
        "base_rule_text": {
          "minLength": 1,
          "title": "Base Rule Text",
          "type": "string"
        },
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "findings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "text_sha256",
        "context_sha256",
        "base_document_id",
        "base_url",
        "base_locator",
        "base_pdf_page",
        "base_rule_text",
        "findings"
      ],
      "title": "TemporalRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudicated_by": {
      "minLength": 1,
      "title": "Adjudicated By",
      "type": "string"
    },
    "adjudicated_on": {
      "format": "date",
      "title": "Adjudicated On",
      "type": "string"
    },
    "audit_flags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Audit Flags",
      "type": "array"
    },
    "challenge_tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Challenge Tags",
      "type": "array"
    },
    "chat_history": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "Chat History",
      "type": "array"
    },
    "exposure": {
      "enum": [
        "historically_used",
        "known_regression",
        "unseen",
        "unknown"
      ],
      "title": "Exposure",
      "type": "string"
    },
    "family_id": {
      "minLength": 1,
      "title": "Family Id",
      "type": "string"
    },
    "gold": {
      "$ref": "#/$defs/GoldLabels"
    },
    "historical_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistoricalRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "legacy_answer": {
      "minLength": 1,
      "title": "Legacy Answer",
      "type": "string"
    },
    "legacy_gold_citations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Legacy Gold Citations",
      "type": "array"
    },
    "legacy_gold_citations_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Gold Citations Raw"
    },
    "legal_as_of": {
      "const": "2026-09-22",
      "default": "2026-09-22",
      "title": "Legal As Of",
      "type": "string"
    },
    "open_review_items": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Open Review Items",
      "type": "array"
    },
    "parent_case_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Case Sha256",
      "type": "string"
    },
    "pilot": {
      "title": "Pilot",
      "type": "boolean"
    },
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "query_type": {
      "enum": [
        "factual",
        "penalty",
        "scenario"
      ],
      "title": "Query Type",
      "type": "string"
    },
    "review_decision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Review Decision Sha256",
      "type": "string"
    },
    "reviewer_notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reviewer Notes",
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/CandidateRevision"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "const": "roadlawqa-current-law-2026-09-22",
      "default": "roadlawqa-current-law-2026-09-22",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRow"
    },
    "split": {
      "enum": [
        "legacy",
        "regression",
        "held_out"
      ],
      "title": "Split",
      "type": "string"
    },
    "temporal_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "split",
    "exposure",
    "query_type",
    "query",
    "source",
    "legacy_answer",
    "gold",
    "revision",
    "family_id",
    "challenge_tags",
    "pilot",
    "parent_case_sha256",
    "review_decision_sha256",
    "adjudicated_by",
    "adjudicated_on"
  ],
  "title": "ReviewedCase",
  "type": "object"
}
