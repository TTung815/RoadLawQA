{
  "$defs": {
    "AnswerFacet": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_group_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Group Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rule",
            "definition",
            "money",
            "license_points",
            "additional_sanction",
            "condition",
            "exception",
            "reasoning",
            "temporal",
            "uncertainty"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "support_state": {
          "default": "unknown",
          "enum": [
            "positive_support",
            "negative_support",
            "unknown"
          ],
          "title": "Support State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "description"
      ],
      "title": "AnswerFacet",
      "type": "object"
    },
    "EvidenceGroup": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "references"
      ],
      "title": "EvidenceGroup",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "article": {
          "minLength": 1,
          "title": "Article",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clause"
        },
        "law": {
          "minLength": 1,
          "title": "Law",
          "type": "string"
        },
        "point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Point"
        },
        "processed_id": {
          "minLength": 1,
          "title": "Processed Id",
          "type": "string"
        },
        "role": {
          "default": "support",
          "enum": [
            "support",
            "context",
            "contradicts_legacy"
          ],
          "title": "Role",
          "type": "string"
        },
        "runtime_id": {
          "minLength": 1,
          "title": "Runtime Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "uuid": {
          "minLength": 1,
          "title": "Uuid",
          "type": "string"
        }
      },
      "required": [
        "processed_id",
        "runtime_id",
        "uuid",
        "citation",
        "law",
        "article",
        "clause",
        "point",
        "text_sha256"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "GoldLabels": {
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of Date"
        },
        "evidence_groups": {
          "items": {
            "$ref": "#/$defs/EvidenceGroup"
          },
          "title": "Evidence Groups",
          "type": "array"
        },
        "expected_coverage": {
          "default": "unassigned",
          "enum": [
            "unassigned",
            "sufficient",
            "insufficient",
            "conditional"
          ],
          "title": "Expected Coverage",
          "type": "string"
        },
        "external_evidence_needed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "External Evidence Needed",
          "type": "array"
        },
        "failure_categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "publication": {
          "$ref": "#/$defs/PublicationExpectation"
        },
        "reference_answer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Answer"
        },
        "required_facets": {
          "items": {
            "$ref": "#/$defs/AnswerFacet"
          },
          "title": "Required Facets",
          "type": "array"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "technical_audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalAudit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal_basis": {
          "default": "unresolved",
          "enum": [
            "unresolved",
            "frozen_corpus",
            "explicit_date"
          ],
          "title": "Temporal Basis",
          "type": "string"
        }
      },
      "required": [
        "publication"
      ],
      "title": "GoldLabels",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "PublicationExpectation": {
      "additionalProperties": false,
      "properties": {
        "allowed_statuses": {
          "items": {
            "enum": [
              "answered",
              "insufficient_evidence",
              "verification_failed"
            ],
            "type": "string"
          },
          "title": "Allowed Statuses",
          "type": "array"
        },
        "disposition": {
          "default": "unassigned",
          "enum": [
            "unassigned",
            "publish",
            "abstain",
            "conditional"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "rationale"
      ],
      "title": "PublicationExpectation",
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "failures": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Failures",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "money_only",
            "complete_pool",
            "wrong_citation",
            "equipment_distractor",
            "accumulation",
            "rewrite_probe",
            "multi_turn",
            "distractor_history",
            "end_to_end"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "maximum": 50,
          "minimum": 1,
          "title": "Parent",
          "type": "integer"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parent",
        "kind",
        "purpose",
        "failures"
      ],
      "title": "Recipe",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "reviewed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed On"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "default": "needs_review",
          "enum": [
            "needs_review",
            "approved",
            "excluded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "StageProbe": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "minLength": 1,
          "title": "Assertion",
          "type": "string"
        },
        "evidence_batches": {
          "items": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "title": "Evidence Batches",
          "type": "array"
        },
        "expected_pool_coverage": {
          "anyOf": [
            {
              "enum": [
                "sufficient",
                "insufficient"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Pool Coverage"
        },
        "missing_facet_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Facet Ids",
          "type": "array"
        },
        "mode": {
          "enum": [
            "end_to_end",
            "fixed_evidence",
            "rewrite_probe"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "assertion"
      ],
      "title": "StageProbe",
      "type": "object"
    },
    "TechnicalAudit": {
      "additionalProperties": false,
      "properties": {
        "audited_on": {
          "format": "date",
          "title": "Audited On",
          "type": "string"
        },
        "citation_status": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "external_source_needed"
          ],
          "title": "Citation Status",
          "type": "string"
        },
        "external_sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "External Sources",
          "type": "array"
        },
        "findings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "recommended_answer": {
          "minLength": 1,
          "title": "Recommended Answer",
          "type": "string"
        },
        "recommended_coverage": {
          "enum": [
            "sufficient",
            "insufficient",
            "conditional"
          ],
          "title": "Recommended Coverage",
          "type": "string"
        },
        "recommended_publication": {
          "$ref": "#/$defs/PublicationExpectation"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "needs_revision",
            "conditional",
            "external_source_needed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "citation_status",
        "audited_on",
        "scope",
        "recommended_answer",
        "recommended_coverage",
        "recommended_publication"
      ],
      "title": "TechnicalAudit",
      "type": "object"
    },
    "TemporalReview": {
      "additionalProperties": false,
      "properties": {
        "result_date": {
          "format": "date",
          "title": "Result Date",
          "type": "string"
        },
        "reviewed_on": {
          "format": "date",
          "title": "Reviewed On",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/TemporalRule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "status": {
          "const": "approved",
          "title": "Status",
          "type": "string"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "verified_through": {
          "format": "date",
          "title": "Verified Through",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_on",
        "valid_from",
        "verified_through",
        "result_date",
        "rules"
      ],
      "title": "TemporalReview",
      "type": "object"
    },
    "TemporalRule": {
      "additionalProperties": false,
      "properties": {
        "base_document_id": {
          "minLength": 1,
          "title": "Base Document Id",
          "type": "string"
        },
        "base_locator": {
          "minLength": 1,
          "title": "Base Locator",
          "type": "string"
        },
        "base_pdf_page": {
          "minimum": 1,
          "title": "Base Pdf Page",
          "type": "integer"
        },
        "base_rule_text": {
          "minLength": 1,
          "title": "Base Rule Text",
          "type": "string"
        },
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "findings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "text_sha256",
        "context_sha256",
        "base_document_id",
        "base_url",
        "base_locator",
        "base_pdf_page",
        "base_rule_text",
        "findings"
      ],
      "title": "TemporalRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chat_history": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "Chat History",
      "type": "array"
    },
    "exposure": {
      "const": "historically_used",
      "default": "historically_used",
      "title": "Exposure",
      "type": "string"
    },
    "family_id": {
      "minLength": 1,
      "title": "Family Id",
      "type": "string"
    },
    "gold": {
      "$ref": "#/$defs/GoldLabels"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "legal_as_of": {
      "const": "2026-09-22",
      "default": "2026-09-22",
      "title": "Legal As Of",
      "type": "string"
    },
    "open_review_items": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Open Review Items",
      "type": "array"
    },
    "parent_case_id": {
      "minLength": 1,
      "title": "Parent Case Id",
      "type": "string"
    },
    "parent_case_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Case Sha256",
      "type": "string"
    },
    "parent_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Manifest Sha256",
      "type": "string"
    },
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "query_type": {
      "enum": [
        "factual",
        "penalty",
        "scenario"
      ],
      "title": "Query Type",
      "type": "string"
    },
    "recipe": {
      "$ref": "#/$defs/Recipe"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "const": "roadlawqa-current-law-2026-09-22",
      "default": "roadlawqa-current-law-2026-09-22",
      "title": "Snapshot Id",
      "type": "string"
    },
    "split": {
      "const": "legacy",
      "default": "legacy",
      "title": "Split",
      "type": "string"
    },
    "stage_probe": {
      "$ref": "#/$defs/StageProbe"
    },
    "suite": {
      "const": "development",
      "default": "development",
      "title": "Suite",
      "type": "string"
    },
    "temporal_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "family_id",
    "query_type",
    "query",
    "parent_case_id",
    "parent_case_sha256",
    "parent_manifest_sha256",
    "recipe",
    "gold",
    "stage_probe",
    "open_review_items"
  ],
  "title": "DevelopmentCase",
  "type": "object"
}
